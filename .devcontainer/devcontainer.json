{
    "name": "cd101 — Ubuntu 24.04",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-in-docker:4.1.3": {}
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-toolsai.jupyter",
                "ms-toolsai.jupyter-keymap",
                "ms-toolsai.jupyter-renderers"
            ],
            "settings": {
                "jupyter.defaultKernel": "bash"
            }
        }
    },
    "forwardPorts": [8888],
    "portsAttributes": {
        "8888": {
            "label": "JupyterLab",
            "onAutoForward": "notify"
        }
    },
    "postCreateCommand": "python3 -m bash_kernel.install --user",
    "remoteUser": "vscode"
}
